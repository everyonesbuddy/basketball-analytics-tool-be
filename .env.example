PORT=5000

# Personal OS
MONGODB_URI=            # MongoDB Atlas connection string (free tier is fine)
JWT_SECRET=             # long random string: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
OS_TIMEZONE=America/New_York

# Comma-separated list of websites allowed to call this API
CORS_ORIGINS=https://basketball-analytics-tool.netlify.app,http://localhost:5173

# Events & concerts: your Ticketmaster Consumer Key (developer.ticketmaster.com). The secret isn't needed.
TICKETMASTER_API_KEY=

# Push notifications (the installed app on your phone).
# Make the keys once: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# Any long random string; an outside pinger calls /api/os/push/run?key=THIS every 5 minutes
PUSH_CRON_SECRET=
